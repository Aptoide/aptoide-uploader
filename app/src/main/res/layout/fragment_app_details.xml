<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_blue">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/fragment_app_details_toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/light_blue_appbar"
      android:minHeight="?attr/actionBarSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageView
          android:id="@+id/fragment_app_details_back"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:padding="8dp"
          android:src="@drawable/ic_arrow_back_24dp"
          tools:ignore="ContentDescription" />

      <TextView
          android:id="@+id/fragment_app_details_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_marginLeft="8dp"
          android:text="@string/app_details_title"
          android:textAppearance="@style/AppTheme.Toolbar.Title"
          android:textColor="@color/white" />
    </LinearLayout>
  </androidx.appcompat.widget.Toolbar>

  <ProgressBar
      android:id="@+id/fragment_app_details_loading"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:visibility="gone"
      tools:visibility="visible" />

  <ScrollView
      android:id="@+id/fragment_app_details_scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@id/fragment_app_details_toolbar"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- App Header Card -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/app_detail_card_background"
          android:orientation="horizontal"
          android:padding="16dp">

        <ImageView
            android:id="@+id/fragment_app_details_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_uploader_big" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:id="@+id/fragment_app_details_app_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/black"
              android:textSize="18sp"
              android:textStyle="bold"
              tools:text="Revolut" />

          <TextView
              android:id="@+id/fragment_app_details_package_name_header"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:ellipsize="middle"
              android:singleLine="true"
              android:textColor="@color/google_grey"
              android:textSize="12sp"
              tools:text="com.revolut.revolut" />
        </LinearLayout>
      </LinearLayout>

      <!-- Version Info Row -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <!-- Version Name Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/app_version_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_version_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="16sp"
              android:textStyle="bold"
              tools:text="10.111" />
        </LinearLayout>

        <!-- Version Code Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/version_code_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_version_code"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="16sp"
              android:textStyle="bold"
              tools:text="123456" />
        </LinearLayout>
      </LinearLayout>

      <!-- SDK Info Row -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <!-- Target SDK Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/target_sdk_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_target_sdk"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="16sp"
              android:textStyle="bold"
              tools:text="34" />
        </LinearLayout>

        <!-- Min SDK Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/min_sdk_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_min_sdk"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="16sp"
              android:textStyle="bold"
              tools:text="21" />
        </LinearLayout>
      </LinearLayout>

      <!-- Package Name Card -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:background="@drawable/app_detail_card_background"
          android:orientation="vertical"
          android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/package_name_label"
            android:textColor="@color/google_grey"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fragment_app_details_package_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:textIsSelectable="true"
            android:textSize="14sp"
            tools:text="com.revolut.revolut" />
      </LinearLayout>

      <!-- App Path Card -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:background="@drawable/app_detail_card_background"
          android:orientation="vertical"
          android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_path_label"
            android:textColor="@color/google_grey"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fragment_app_details_app_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="/data/app/~~CVpTXaydEKWEjeuxtZaIsQ==/com.revolut.revolut-vHsnT3GAHfhaXazwprfNkw==/base.apk" />
      </LinearLayout>

      <!-- App Size and Type Row -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <!-- App Size Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/app_size_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_app_size"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="16sp"
              android:textStyle="bold"
              tools:text="199.6 MB" />
        </LinearLayout>

        <!-- App Type Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/app_type_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_app_type"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="14sp"
              android:textStyle="bold"
              tools:text="App Bundle" />
        </LinearLayout>
      </LinearLayout>

      <!-- File Paths Card (Expandable) -->
      <LinearLayout
          android:id="@+id/fragment_app_details_files_card"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:background="@drawable/app_detail_card_background"
          android:orientation="vertical"
          android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_paths_label"
            android:textColor="@color/google_grey"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/fragment_app_details_files_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
      </LinearLayout>

      <!-- Dates Row -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:orientation="horizontal">

        <!-- Install Date Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/install_date_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_install_date"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="14sp"
              android:textStyle="bold"
              tools:text="11 Sep 2025" />
        </LinearLayout>

        <!-- Update Date Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/app_detail_card_background"
            android:orientation="vertical"
            android:padding="16dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/update_date_label"
              android:textColor="@color/google_grey"
              android:textSize="12sp" />

          <TextView
              android:id="@+id/fragment_app_details_update_date"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textColor="@color/black"
              android:textSize="14sp"
              android:textStyle="bold"
              tools:text="15 Dec 2025" />
        </LinearLayout>
      </LinearLayout>

      <!-- Bottom spacing -->
      <View
          android:layout_width="match_parent"
          android:layout_height="24dp" />

    </LinearLayout>
  </ScrollView>
</RelativeLayout>
